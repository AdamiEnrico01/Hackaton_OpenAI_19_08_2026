# crIA — variáveis de ambiente
# Copie para .env.local e preencha. O .env.local está no .gitignore e nunca deve ser versionado.

# --- Supabase (schema em supabase/schema.sql; ainda não consumido pelas telas) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Vercel AI Gateway (texto, brandbook e imagem) ---
# Sem esta chave: campanha responde em modo demo, imagem e brandbook respondem 503.
AI_GATEWAY_API_KEY=
CRIA_TEXT_MODEL=openai/gpt-5.6-luna
CRIA_BRAND_MODEL=openai/gpt-5.6-luna
CRIA_IMAGE_MODEL=openai/gpt-image-2

# --- Apify (coleta de site e Instagram no onboarding) ---
# Sem token: POST /api/brand/ingest responde 503.
APIFY_API_TOKEN=
APIFY_WEBSITE_ACTOR=apify/website-content-crawler
APIFY_INSTAGRAM_ACTOR=apify/instagram-profile-scraper

# --- Proteção das rotas pagas ---
# Só é exigido fora da Vercel. Se definido em dev local, as rotas passam a pedir
# "Authorization: Bearer <token>" e as telas atuais NÃO enviam esse header.
# Deixe vazio para desenvolvimento local.
CRIA_TEST_TOKEN=
